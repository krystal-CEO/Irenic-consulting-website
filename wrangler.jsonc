{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "irenic-consulting-website",
  "compatibility_date": "2026-10-10",
  "main": "automation/worker.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "previews": {},
  "d1_databases": [
    {
      "binding": "CONSULTING_DB",
      "database_name": "irenic-consulting-inquiries",
      "database_id": "3a6778fb-510e-4224-9cc7-4800b7cce7f7"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFt56Aon8K7YT-G-",
    "INQUIRIES_ENABLED": "false"
  }
}
