{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "irenic-consulting-website",
  "compatibility_date": "2026-10-10",
  "main": "automation/worker.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "previews": {}
}
